{
  "version": 2,

  "routes": [
    {
      "src": "/api/auth/login",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/auth/status",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/auth/callback",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/auth/logout",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/send-email",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/test",
      "dest": "/api/test.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],

  "functions": {
    "api/index.py": {
      "runtime": "python3.9",
      "maxDuration": 30
    }
  },

  "cleanUrls": true,
  "trailingSlash": false,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/icon-(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}