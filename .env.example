# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console
GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"your-client-id-here","client_secret":"your-client-secret-here","redirect_uris":["http://localhost:3000/api/auth/callback","https://your-domain.vercel.app/api/auth/callback"]}}

# For production, replace the values above with your actual Google OAuth credentials
