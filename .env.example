# ——— Public app URL (must match Google OAuth authorized domains) ———
# Production canonical domain:
NEXT_PUBLIC_APP_URL=https://mailmycertificate.tech
APP_URL=https://mailmycertificate.tech

# Google Search Console HTML tag verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Comma-separated extra origins (optional preview deploys)
# ALLOWED_ORIGINS=https://mailmycertificate.tech,http://localhost:3000

# Optional override if Google Console uses a different callback path
# OAUTH_REDIRECT_URI=https://mailmycertificate.tech/api/auth/callback

# ——— Flask ———
FLASK_SECRET_KEY=your-secret-key-here

# ——— Google OAuth (Gmail send) ———
# redirect_uris MUST include:
#   http://localhost:3000/api/auth/callback
#   https://mailmycertificate.tech/api/auth/callback
GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"your-client-id","client_secret":"your-client-secret","redirect_uris":["http://localhost:3000/api/auth/callback","https://mailmycertificate.tech/api/auth/callback"]}}
