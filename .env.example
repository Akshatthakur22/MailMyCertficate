# ============================================================
# MailMyCertificate - Environment Variables
# ============================================================

# ============================================================
# Application
# ============================================================

# Public URL (Production)
NEXT_PUBLIC_APP_URL=https://mailmycertificate.tech
APP_URL=https://mailmycertificate.tech

# Development
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL=http://localhost:3000

# Additional allowed origins (optional)
# ALLOWED_ORIGINS=https://mailmycertificate.tech,http://localhost:3000

# OAuth callback override (optional)
# OAUTH_REDIRECT_URI=https://mailmycertificate.tech/api/auth/callback

# ============================================================
# Analytics
# ============================================================

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Google Search Console Verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# ============================================================
# Flask
# ============================================================

# Secret key used by Flask sessions
FLASK_SECRET_KEY=replace-with-a-random-secret

# ============================================================
# Google OAuth (Gmail)
# ============================================================

# Create OAuth credentials in Google Cloud Console.
# Authorized Redirect URIs MUST include:
#   http://localhost:3000/api/auth/callback
#   https://mailmycertificate.tech/api/auth/callback

GOOGLE_CREDENTIALS_JSON={
  "web":{
    "client_id":"YOUR_GOOGLE_CLIENT_ID",
    "client_secret":"YOUR_GOOGLE_CLIENT_SECRET",
    "redirect_uris":[
      "http://localhost:3000/api/auth/callback",
      "https://mailmycertificate.tech/api/auth/callback"
    ]
  }
}
